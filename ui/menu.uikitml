<style>
  .root {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 30;
    gap: 14;
    background-color: rgba(0, 8, 25, 0.92);
    border-radius: 16;
    border-width: 2;
    border-color: rgba(0, 255, 255, 0.3);
    width: 340;
  }
  .title {
    font-size: 36;
    color: #ffffff;
    margin-bottom: 4;
  }
  .subtitle {
    font-size: 14;
    color: rgba(136, 204, 255, 0.8);
    margin-bottom: 10;
  }
  .btn {
    padding: 12;
    background-color: rgba(0, 255, 255, 0.12);
    border-radius: 8;
    border-width: 1;
    border-color: rgba(0, 255, 255, 0.4);
    width: 260;
    align-items: center;
    cursor: pointer;
  }
  .btn-text {
    font-size: 18;
    color: #00ffff;
  }
  .btn-xr {
    padding: 12;
    background-color: rgba(136, 68, 255, 0.15);
    border-radius: 8;
    border-width: 1;
    border-color: rgba(136, 68, 255, 0.5);
    width: 260;
    align-items: center;
    cursor: pointer;
  }
  .btn-xr-text {
    font-size: 18;
    color: #8844ff;
  }
  .highscore {
    font-size: 13;
    color: rgba(255, 221, 136, 0.7);
    margin-top: 6;
  }
  .snowflake-row {
    flex-direction: row;
    gap: 10;
  }
  .snowflake {
    font-size: 20;
    color: rgba(200, 230, 255, 0.5);
  }
</style>
<Panel class="root">
  <div class="snowflake-row">
    <div class="snowflake">❄</div>
    <div class="snowflake">❄</div>
    <div class="snowflake">❄</div>
  </div>
  <div class="title">NEON SNOWBALL</div>
  <div class="subtitle">SNOWBALL FIGHT ARENA</div>
  <div class="btn" id="btn-play">
    <div class="btn-text">PLAY</div>
  </div>
  <div class="btn" id="btn-settings">
    <div class="btn-text">SETTINGS</div>
  </div>
  <div class="btn" id="btn-tutorial">
    <div class="btn-text">HOW TO PLAY</div>
  </div>
  <div class="btn-xr" id="btn-xr">
    <div class="btn-xr-text">ENTER VR</div>
  </div>
  <div class="highscore" id="high-score">HIGH SCORE: 0</div>
</Panel>
